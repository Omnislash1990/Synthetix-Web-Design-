# Google Analytics 4 measurement ID. The tag loads only after the visitor accepts cookies.
# Leave this unset to load nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Search Console token only (the content value, not the full meta tag).
# Leave this unset to omit the google-site-verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public Google review link. Leave this unset to hide the review button.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# International WhatsApp number, digits only, with the country code and no plus sign.
# The "Message us on WhatsApp" button is hidden when this is empty.
# NEXT_PUBLIC_ values are inlined at build time. Set this in the
# synthetix-web-design Vercel project, then redeploy. Do not commit the number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Care plan offer line. Shown only when this is exactly "true".
# Any other value, including leaving it unset, keeps the line hidden. Default is off.
# The line is: First 3 clients this month get the first month of the care plan free
# It does not change estimator prices. Set it in Vercel and redeploy to switch it.
NEXT_PUBLIC_SHOW_CARE_PLAN_OFFER=

# Server-only Resend API key. If this is unset, the contact form does not send
# email and falls back to an email draft (and WhatsApp when that number is set).
# Never commit a real key.
RESEND_API_KEY=

# From address for enquiry email. Must be a verified sender in Resend.
# When unset, the server uses: Synthetix Studio <enquiries@synthetixstudio.co.uk>
# Enquiries are delivered to synthetix.studio1@gmail.com.
CONTACT_FROM_EMAIL=
