# Google Analytics 4 measurement ID. The tag loads only after the visitor accepts cookies.
# Leave this unset to load nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Search Console token only (the content value, not the full meta tag).
# Leave this unset to omit the google-site-verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public Google review link. Leave this unset to hide the review button.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
